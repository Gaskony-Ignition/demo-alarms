                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "toStr({session.custom.live.total})"
                      }
                    }
                  },
                  "props.style.color": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({session.custom.live.counts.Critical} > 0, \"var(--crit)\", if({session.custom.live.counts.High} > 0, \"var(--high)\", if({session.custom.live.total} > 0, \"var(--med)\", \"var(--ok)\")))"
                      }
                    }
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "auto"
                }
              }
            ],
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "36px"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Unacked"
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "11px",
                "textAlign": "center",
                "classes": "ad-faint ad-nav-text"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "toStr({session.custom.live.unacked}) + \" unacknowledged\""
                  }
                }
              }
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "15px"
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Theme"
            },
            "props": {
              "direction": "column",
              "style": {
                "paddingTop": "10px",
                "marginTop": "4px",
                "borderTop": "1px solid var(--line)",
                "gap": "3px",
                "classes": "ad-nav-theme"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "ThemeLabel"
                },
                "props": {
                  "text": "THEME",
                  "style": {
                    "classes": "ad-kpi-label ad-nav-text"
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "13px"
                }
              },
              {
                "type": "ia.input.dropdown",
                "meta": {
                  "name": "Pick"
                },
                "props": {
                  "options": [],
                  "placeholder": "Theme",
                  "allowClearing": false,
                  "showSearch": false,
                  "style": {
                    "height": "30px",
                    "classes": "ad-nav-text ad-theme-select"
                  }
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "session.props.theme",
                        "bidirectional": true
                      }
                    }
                  },
                  "props.options": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "1"
                      },
                      "transforms": [
                        {
                          "type": "script",
                          "code": "\treturn AlarmDemo.ui.themeOptions()"
                        }
                      ]
                    }
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "30px"
                }
              }
            ],
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "57px"
            }
          }
        ],
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "162px"
        }
      }
    ],
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "\"ad-nav ad-root\" + if({session.custom.navOpen} = true, \"\", \" ad-nav-shut\")"
          }
        }
      }
    }
  }
}
