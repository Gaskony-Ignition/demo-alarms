{
  "custom": {
    "run": false,
    "fault": false
  },
  "params": {
    "title": "Motor",
    "path": ""
  },
  "props": {
    "defaultSize": {
      "width": 150,
      "height": 64
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "gap": "2px",
        "classes": "ad-equip"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Row"
        },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "gap": "8px"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Dot"
            },
            "props": {
              "direction": "row",
              "style": {
                "classes": "ad-dot"
              }
            },
            "children": [],
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.fault} = true, \"ad-dot ad-dot-fault\", if({view.custom.run} = true, \"ad-dot ad-dot-run\", \"ad-dot ad-dot-stop\"))"
                  }
                }
              }
            },
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "10px"
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Name"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "ad-equip-name"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.title"
                  }
                }
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1
            }
          }
        ],
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "15px"
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "State"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "ad-equip-state"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.fault} = true, \"FAULT\", if({view.custom.run} = true, \"RUNNING\", \"STOPPED\"))"
              }
            }
          },
          "props.style.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.fault} = true, \"var(--crit)\", if({view.custom.run} = true, \"var(--ok)\", \"var(--ink-3)\"))"
              }
            }
          }
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "14px"
        }
      }
    ]
  },
  "propConfig": {
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.path": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.run": {
      "binding": {
        "type": "tag",
        "config": {
          "tagPath": "[AlarmDemo]{1}/Run",
          "mode": "indirect",
          "references": {
            "1": "{view.params.path}"
          }
        }
      }
    },
    "custom.fault": {
      "binding": {
        "type": "tag",
        "config": {
          "tagPath": "[AlarmDemo]{1}/Fault",
          "mode": "indirect",
          "references": {
            "1": "{view.params.path}"
          }
        }
      }
    }
  }
}
