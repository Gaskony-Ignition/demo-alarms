{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "width": 1600,
      "height": 900
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "0 0 12px 0",
        "height": "100%",
        "gap": "12px",
        "classes": "ad-page ad-root"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "padding": "0 20px",
            "height": "100%",
            "gap": "14px",
            "classes": "ad-header"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Titles"
            },
            "props": {
              "direction": "column"
            },
            "children": [
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "TitleRow"
                },
                "props": {
                  "direction": "row",
                  "alignItems": "center"
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "Site"
                    },
                    "props": {
                      "text": "",
                      "style": {
                        "whiteSpace": "nowrap",
                        "classes": "ad-title ad-title-site"
                      }
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{session.custom.siteInfo.label} + \"\u00a0\u00a0-\u00a0\u00a0\""
                          }
                        }
                      }
                    },
                    "position": {
                      "grow": 0,
                      "shrink": 0,
                      "basis": "auto"
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "Title"
                    },
                    "props": {
                      "text": "",
                      "style": {
                        "whiteSpace": "nowrap",
                        "overflow": "hidden",
                        "textOverflow": "ellipsis",
                        "classes": "ad-title"
                      }
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "type": "property",
                          "config": {
                            "path": "page.props.title"
                          }
                        }
                      }
                    },
                    "position": {
                      "grow": 1,
                      "shrink": 1
                    }
                  }
                ],
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "26px"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Sub"
                },
                "props": {
                  "text": "",
                  "style": {
                    "whiteSpace": "nowrap",
                    "overflow": "hidden",
                    "textOverflow": "ellipsis",
                    "classes": "ad-subtitle ad-title-site"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "session.custom.siteInfo.subtitle"
                      }
                    }
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "15px"
                }
              }
            ],
            "position": {
              "grow": 1,
              "shrink": 1
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "SiteSwitch"
            },
            "props": {
              "direction": "row",
              "alignItems": "center",
              "style": {
                "gap": "6px"
              }
            },
            "children": [
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "B_Water"
                },
                "props": {
                  "text": "Water Treatment",
                  "style": {
                    "classes": "ad-btn"
                  }
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({session.custom.site} = \"Water\", \"ad-btn ad-btn-active\", \"ad-btn\")"
                      }
                    }
                  }
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tself.session.custom.site = 'Water'"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "140px"
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "B_Manufacturing"
                },
                "props": {
                  "text": "Manufacturing",
                  "style": {
                    "classes": "ad-btn"
                  }
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({session.custom.site} = \"Manufacturing\", \"ad-btn ad-btn-active\", \"ad-btn\")"
                      }
                    }
                  }
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tself.session.custom.site = 'Manufacturing'"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "130px"
                }
              }
            ],
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "276px"
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Scenario"
            },
            "props": {
              "direction": "row",
              "alignItems": "center"
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "ScenarioLabel"
                },
                "props": {
                  "text": "",
                  "style": {
                    "padding": "5px 12px",
                    "classes": "ad-scenario-banner"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "\"SCENARIO:  \" + upper({session.custom.scenario})"
                      }
                    }
                  },
                  "props.style.display": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({session.custom.scenario} = \"None\", \"none\", \"flex\")"
                      }
                    }
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "auto"
                }
              }
            ],
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Chips"
            },
            "props": {
              "direction": "row",
              "alignItems": "center",
              "style": {
                "gap": "7px"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Critical"
                },
                "props": {
                  "text": "",
                  "style": {
                    "padding": "3px 11px",
                    "classes": "ad-chip ad-chip-critical"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "toStr({session.custom.live.counts.Critical}) + \"  CRITICAL\""
                      }
                    }
                  },
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "\"ad-chip ad-chip-critical\" + if({session.custom.live.counts.Critical} > 0, \" ad-live\", \"\")"
                      }
                    }
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "High"
                },
                "props": {
                  "text": "",
                  "style": {
                    "padding": "3px 11px",
                    "classes": "ad-chip ad-chip-high"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "toStr({session.custom.live.counts.High}) + \"  HIGH\""
                      }
                    }
                  },
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "\"ad-chip ad-chip-high\" + if({session.custom.live.counts.High} > 0, \" ad-live\", \"\")"
                      }
                    }
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Medium"
                },
                "props": {
                  "text": "",
                  "style": {
                    "padding": "3px 11px",
                    "classes": "ad-chip ad-chip-medium"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "toStr({session.custom.live.counts.Medium}) + \"  MEDIUM\""
                      }
                    }
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "auto"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Low"
                },
                "props": {
                  "text": "",
                  "style": {
                    "padding": "3px 11px",
                    "classes": "ad-chip ad-chip-low"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "toStr({session.custom.live.counts.Low}) + \"  LOW\""
                      }
                    }
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "auto"
                }
              }
            ],
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "auto"
            }
          }
        ],
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "64px"
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Mimic"
        },
        "props": {
          "direction": "row",
          "style": {
            "padding": "0 12px",
            "minHeight": "330px",
            "maxHeight": "460px"
          }
        },
        "children": [
          {
            "type": "ia.display.view",
            "meta": {
              "name": "SiteMimic"
            },
            "props": {
              "path": "AlarmDemo/Sites/Water"
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({session.custom.site} = \"Manufacturing\", \"AlarmDemo/Sites/Manufacturing\", \"AlarmDemo/Sites/Water\")"
                  }
                }
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1
            }
          }
        ],
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "0%"
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "ActiveAlarms"
        },
        "props": {
          "direction": "column",
          "style": {
            "padding": "12px",
            "margin": "0 12px",
            "minHeight": "180px",
            "maxHeight": "460px",
            "gap": "8px",
            "classes": "ad-card"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Head"
            },
            "props": {
              "direction": "row",
              "alignItems": "center",
              "style": {
                "gap": "8px"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "T"
                },
                "props": {
                  "text": "ACTIVE ALARMS",
                  "style": {
                    "classes": "ad-card-head"
                  }
                },
                "position": {
                  "grow": 1,
                  "shrink": 1
                }
              },
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "OverviewColour"
                },
                "props": {
                  "direction": "row",
                  "alignItems": "center",
                  "style": {
                    "gap": "8px"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "L"
                    },
                    "props": {
                      "text": "PRIORITY COLOUR",
                      "style": {
                        "alignSelf": "center",
                        "classes": "ad-kpi-label"
                      }
                    },
                    "position": {
                      "grow": 0,
                      "shrink": 0,
                      "basis": "116px"
                    }
                  },
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "M_rows"
                    },
                    "props": {
                      "text": "Whole row",
                      "style": {
                        "classes": "ad-btn ad-btn-sm"
                      }
                    },
                    "propConfig": {
                      "props.style.classes": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if({session.custom.alarmColour} = \"rows\", \"ad-btn ad-btn-sm ad-btn-active\", \"ad-btn ad-btn-sm\")"
                          }
                        }
                      }
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\tself.session.custom.alarmColour = 'rows'"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "position": {
                      "grow": 0,
                      "shrink": 0,
                      "basis": "122px"
                    }
                  },
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "M_cells"
                    },
                    "props": {
                      "text": "Priority only",
                      "style": {
                        "classes": "ad-btn ad-btn-sm"
                      }
                    },
                    "propConfig": {
                      "props.style.classes": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "if({session.custom.alarmColour} = \"cells\", \"ad-btn ad-btn-sm ad-btn-active\", \"ad-btn ad-btn-sm\")"
                          }
                        }
                      }
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\tself.session.custom.alarmColour = 'cells'"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "position": {
                      "grow": 0,
                      "shrink": 0,
                      "basis": "122px"
                    }
                  }
                ],
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "380px"
                }
              }
            ],
            "position": {
              "grow": 0,
              "shrink": 0,
              "basis": "30px"
            }
          },
          {
            "type": "ia.display.table",
            "meta": {
              "name": "Table"
            },
            "props": {
              "style": {
                "classes": "ad-table ad-table-plain"
              },
              "pager": {
                "bottom": false,
                "top": false
              },
              "columns": [
                {
                  "field": "Active time",
                  "visible": true,
                  "editable": false,
                  "header": {
                    "title": "Active time"
                  },
                  "width": 160,
                  "strictWidth": true
                },
                {
                  "field": "Alarm",
                  "visible": true,
                  "editable": false,
                  "header": {
                    "title": "Alarm"
                  }
                },
                {
                  "field": "Priority",
                  "visible": true,
                  "editable": false,
                  "header": {
                    "title": "Priority"
                  },
                  "width": 112,
                  "strictWidth": true,
                  "render": "view",
                  "viewPath": "AlarmDemo/Widgets/PriorityCell"
                },
                {
                  "field": "State",
                  "visible": true,
                  "editable": false,
                  "header": {
                    "title": "State"
                  },
                  "width": 150,
                  "strictWidth": true
                }
              ]
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"ad-table ad-table-plain ad-colour-\" + {session.custom.alarmColour}"
                  }
                }
              },
              "props.data": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.custom.site} + toStr(now(3000))"
                  },
                  "transforms": [
                    {
                      "type": "script",
                      "code": "\treturn AlarmDemo.alarms.activeAlarms(self.session.custom.site)"
                    }
                  ]
                }
              },
              "position.grow": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({session.custom.live.total} > 0, 1, 0)"
                  }
                }
              },
              "position.basis": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({session.custom.live.total} > 0, \"auto\", \"0px\")"
                  }
                }
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "AllClear"
            },
            "props": {
              "direction": "column",
              "justify": "center",
              "style": {
                "gap": "4px"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Msg"
                },
                "props": {
                  "text": "No active alarms on this site",
                  "style": {
                    "textAlign": "center",
                    "color": "var(--ok)",
                    "fontSize": "14px",
                    "fontWeight": "600"
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "20px"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Sub"
                },
                "props": {
                  "text": "the plant is running within limits",
                  "style": {
                    "textAlign": "center",
                    "fontSize": "12px",
                    "classes": "ad-faint"
                  }
                },
                "position": {
                  "grow": 0,
                  "shrink": 0,
                  "basis": "16px"
                }
              }
            ],
            "propConfig": {
              "props.style.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({session.custom.live.total} > 0, \"none\", \"flex\")"
                  }
                }
              }
            },
            "position": {
              "grow": 1,
              "shrink": 1
            }
          }
        ],
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "0%"
        }
      }
    ]
  }
}
